cabal-version:      2.4
name:               export-fixture
version:            0.1.0.0

library
    exposed-modules:  ExposedApi
    other-modules:    MakeExplicitUsed
                      UsesMakeExplicitUsed
                      RefineExports
                      UsesRefineExports
                      RefineNamespaces
                      UsesRefineNamespaces
                      MultilineRefine
                      UsesMultilineRefine
                      RefinePartialCtor
                      UsesRefinePartialCtor
                      RefineUnusedCtor
                      UsesRefineUnusedCtor
                      RefineImplicitCtor
                      UsesRefineImplicitCtor
                      ReexportOrigin
                      ReexportFacade
                      UsesReexportFacade
                      WholeReexport
                      FieldOrigin
                      FieldFacade
                      UsesFieldFacade
                      CppExportNoDirective
                      UsesCppExportNoDirective
                      CppExportDirective
                      QualifiedReexport
                      UsesQualifiedReexport
                      CommentedExports
                      UsesCommentedExports
                      DeprecatedHeader
                      UsesDeprecatedHeader
    hs-source-dirs:   .
    build-depends:    base
    default-language: Haskell2010
    default-extensions: TypeOperators
                        PatternSynonyms
                        ExplicitNamespaces
